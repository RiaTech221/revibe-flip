# ==============================================================================
# ReVibe FliP - Backend Environment Template (backend/.env.example)
# ==============================================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Base de données locale ou Docker
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/revibeflip?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword

# Sécurité JWT (SEC-05 : obligatoire hors du code, min 32 octets aléatoires en production)
REVIBE_JWT_SECRET=
REVIBE_JWT_EXPIRATION_MS=900000

# Paramètres Métier Séquestre
REVIBE_COMMISSION_RATE=0.20
REVIBE_VALIDATION_FEE_RATE=0.01
UPLOAD_DIR=uploads/

# PayTech Mobile Money (Wave, Orange Money, Free Money - https://doc.paytech.sn)
# Utiliser PAYTECH_ENV=prod pour le paiement réel (ou 'test' en sandbox)
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=prod
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_IPN_URL=https://api.revibeflip.sn/api/payments/ipn
PAYTECH_SUCCESS_URL=https://revibeflip.sn/orders/payment-return?status=success
PAYTECH_CANCEL_URL=https://revibeflip.sn/orders/payment-return?status=cancel
PAYTECH_TRANSFER_CALLBACK_URL=https://api.revibeflip.sn/api/payments/transfer-ipn
PAYTECH_ALLOWED_IPS=
