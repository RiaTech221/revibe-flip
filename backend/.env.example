# ==============================================================================
# ReVibe FliP - Backend Environment Template (backend/.env.example)
# ==============================================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Base de données locale ou Docker
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/revibeflip?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword

# Sécurité JWT
REVIBE_JWT_SECRET=9a3f2c5d8e1b4a7f0c3e6b9d2a5f8e1b4a7f0c3e6b9d2a5f8e1b4a7f0c3e6b9d
REVIBE_JWT_EXPIRATION_MS=86400000

# Paramètres Métier Séquestre
REVIBE_COMMISSION_RATE=0.20
REVIBE_VALIDATION_FEE_RATE=0.01
UPLOAD_DIR=uploads/
