# ==============================================================================
# ReVibe FliP - Environment Variables Template (.env.example)
# Copiez ce fichier vers '.env' et ajustez les valeurs selon votre environnement.
# Ne JAMAIS commiter le fichier '.env' dans le dépôt Git (protégé par .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT GLOBAL
# ------------------------------------------------------------------------------
APP_ENV=production
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES (MySQL 8.0 / Aurora)
# ------------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=revibeflip
MYSQL_USER=revibeflip_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# URL JDBC complète pour Spring Boot (utilisateur dédié sans privilèges DDL en prod)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/revibeflip?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=revibeflip_user
SPRING_DATASOURCE_PASSWORD=

# ------------------------------------------------------------------------------
# 3. BACKEND (Spring Boot 3 / Java 21)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
BACKEND_PORT=8080

# Clé secrète JWT (Minimum 32 caractères aléatoires, ex: openssl rand -base64 48)
REVIBE_JWT_SECRET=
REVIBE_JWT_ACCESS_EXPIRATION_MS=900000
REVIBE_JWT_REFRESH_EXPIRATION_MS=604800000

# Bootstrap du premier administrateur (à supprimer ou vider après création)
REVIBE_ADMIN_BOOTSTRAP_PHONE=
REVIBE_ADMIN_BOOTSTRAP_PASSWORD=
REVIBE_ADMIN_BOOTSTRAP_NAME=

# Commission ReVibe FliP (20% par défaut) et frais de validation (1%)
REVIBE_COMMISSION_RATE=0.20
REVIBE_VALIDATION_FEE_RATE=0.01
REVIBE_AUTO_CONFIRM_DAYS=7

# Stockage des images et pièces justificatives
UPLOAD_DIR=uploads/

# ------------------------------------------------------------------------------
# 4. FRONTEND WEB (React 18 / Vite / Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 5. MOBILE APP (React Native / Expo)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# ------------------------------------------------------------------------------
# 6. PAYTECH (Obligatoire en production - https://doc.paytech.sn)
# ------------------------------------------------------------------------------
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_IPN_URL=https://api.revibeflip.sn/api/payments/ipn
PAYTECH_SUCCESS_URL=https://revibeflip.sn/orders/payment-return?status=success
PAYTECH_CANCEL_URL=https://revibeflip.sn/orders/payment-return?status=cancel
PAYTECH_TRANSFER_CALLBACK_URL=https://api.revibeflip.sn/api/payments/transfer-ipn
PAYTECH_ALLOWED_IPS=

# ------------------------------------------------------------------------------
# 7. FOURNISSEUR SMS / OTP (Obligatoire en production)
# ------------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=ReVibeFliP
