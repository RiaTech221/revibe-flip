# ==============================================================================
# ReVibe FliP - Environment Variables Template (.env.example)
# Copiez ce fichier vers '.env' et ajustez les valeurs selon votre environnement.
# Ne JAMAIS commiter le fichier '.env' dans le dépôt Git (protégé par .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT GLOBAL
# ------------------------------------------------------------------------------
APP_ENV=production
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES (MySQL 8.0 / Aurora)
# ------------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=revibeflip
MYSQL_USER=revibeflip_user
MYSQL_PASSWORD=VotreMotDePasseSecurise123!
MYSQL_ROOT_PASSWORD=RootSecretChangeMe2026!

# URL JDBC complète pour Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/revibeflip?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=RootSecretChangeMe2026!

# ------------------------------------------------------------------------------
# 3. BACKEND (Spring Boot 3 / Java 21)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
BACKEND_PORT=8080

# Clé secrète JWT (Minimum 256 bits / 32 caractères aléatoires sécurisés)
REVIBE_JWT_SECRET=9a3f2c5d8e1b4a7f0c3e6b9d2a5f8e1b4a7f0c3e6b9d2a5f8e1b4a7f0c3e6b9d
REVIBE_JWT_EXPIRATION_MS=86400000

# Commission ReVibe FliP (20% par défaut) et frais de séquestre (1%)
REVIBE_COMMISSION_RATE=0.20
REVIBE_VALIDATION_FEE_RATE=0.01

# Stockage des images et pièces justificatives
UPLOAD_DIR=uploads/

# ------------------------------------------------------------------------------
# 4. FRONTEND WEB (React 18 / Vite / Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 5. MOBILE APP (React Native / Expo)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# ------------------------------------------------------------------------------
# 6. INTÉGRATIONS DE PAIEMENT MOBILE MONEY (Optionnel / Prod)
# ------------------------------------------------------------------------------
WAVE_API_KEY=
WAVE_MERCHANT_ID=
ORANGE_MONEY_API_KEY=
MTN_MOMO_API_KEY=
MOOV_MONEY_API_KEY=
